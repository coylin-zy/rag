{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "@types/node"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@worker/*": ["./src/worker/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/worker/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/web/**/*.ts"]
}
